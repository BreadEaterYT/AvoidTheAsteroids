{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2015",
    "module": "node20",
    "moduleResolution": "node16",
    "lib": ["es2015", "dom"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}